{
  "name": "arabacheck",
  "productName": "ArabaCheck",
  "version": "1.1.2",
  "description": "İkinci el araç analizi",
  "main": "app/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "node build/make-icons.js && electron-packager . ArabaCheck --platform=win32 --arch=x64 --icon=build/icon.ico --out=dist --overwrite --asar --prune=true --ignore=^/dist --ignore=^/build --app-copyright=ArabaCheck --win32metadata.ProductName=ArabaCheck --win32metadata.FileDescription=ArabaCheck",
    "dist:mac": "node build/make-icons.js && electron-packager . ArabaCheck --platform=darwin --arch=universal --icon=build/icon.icns --out=dist --overwrite --asar --ignore=^/dist --ignore=^/build",
    "dist:linux": "node build/make-icons.js && electron-packager . ArabaCheck --platform=linux --arch=x64 --out=dist --overwrite --asar --ignore=^/dist --ignore=^/build"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "@electron/packager": "20.3.0"
  }
}
